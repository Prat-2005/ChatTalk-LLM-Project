# ChatTalk environment variables
# Copy this file to `.env` and fill in real values. ChatTalk reads these
# at import time (see llm.py).

# --- Primary LLM provider -----------------------------------------------
# Options: ollama (default) or anthropic
LLM_PROVIDER=YOUR_LOCAL_PROVIDER

# Model name as the primary server knows it
LLM_MODEL=YOUR_LOCAL_MODEL

# Endpoint for the local chat server (Ollama)
LLM_BASE_URL=YOUR_LOCAL_BASE_URL

# --- Fallback provider ---------------------------------------------------
# If the primary provider fails (timeout, connection error, HTTP error) the
# app can fall back to Groq so the conversation can continue.
FALLBACK_PROVIDER=YOUR_FALLBACK_PROVIDER

# Model to use for the fallback provider
FALLBACK_MODEL=YOUR_FALLBACK_MODEL

# Fallback Base URL (optional)
FALLBACK_BASE_URL=YOUR_FALLBACK_BASE_URL

# Leave FALLBACK_API_KEY blank in the example — paste your real key here.
FALLBACK_API_KEY=YOUR_FALLBACK_API_KEY

# --- Sampling ------------------------------------------------------------
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=512

# --- Storage -------------------------------------------------------------
# Where on-disk chat history is persisted. Created on first run.
CHATTALK_DATA_DIR=.chattalk_data
